# Copy to .env for local dev (docker-compose reads it). Never commit real secrets.

# This service
BIND_ADDR=0.0.0.0:8080
PUBLIC_URL=http://localhost:8080
# 32 bytes, base64. Generate: `openssl rand -base64 32`
TOKEN_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Postgres
DATABASE_URL=postgres://mcpgw:mcpgw@localhost:5432/mcp_gateway

# Hydra
# Issuer = what Claude uses to reach the AS, and where this service sends a
# browser to have somebody signed in. Both are client relationships.
HYDRA_ISSUER=http://localhost:4444
# Admin API = cluster-internal. Only introspection now — the login and consent
# handshake belongs to the login provider, not to this service.
HYDRA_ADMIN_URL=http://localhost:4445

# Where Hydra delegates login and consent. A separate service (radiosilence's
# `auth`), which is also what decides who may sign in at all — this service no
# longer has an allowlist, and does not know what GitHub is.
AUTH_URL=http://localhost:8082

# This service's own registration at the issuer, as an ordinary relying party.
# In production the login provider generates these and derives the redirect URI
# from PUBLIC_URL; locally, register a client with
# redirect_uris=["${PUBLIC_URL}/auth/callback"] and paste them here.
OIDC_CLIENT_ID=mcp-gateway
OIDC_CLIENT_SECRET=

# Backend MCPs are declared in MCP_REGISTRY, which docker-compose.yml sets on
# the gateway service alongside the backends it names — not here. Their per-user
# credentials are entered in the dashboard and stored encrypted. Nothing
# MCP-specific belongs in this file.

# --- Cloudflare tunnel (only to test the Claude connector) ---
# Use `mise run tunnel` — it provisions the tunnel and sets PUBLIC_URL /
# HYDRA_ISSUER to the tunnel hostnames itself, so you don't edit them here.
# The login provider's GitHub app callback is its own business, not this
# service's — nothing here changes when the tunnel does. See README.
