# Copy to .env for local dev (docker-compose reads it). Never commit real secrets.

# This service
BIND_ADDR=0.0.0.0:8080
PUBLIC_URL=http://localhost:8080
# 32 bytes, base64. Generate: `openssl rand -base64 32`
TOKEN_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Postgres
DATABASE_URL=postgres://fastmail:fastmail@localhost:5432/fastmail_mcp

# Hydra
# Issuer = what Claude uses to reach the AS (advertised in metadata).
HYDRA_ISSUER=http://localhost:4444
# Admin API = cluster-internal, used for introspection + login/consent.
HYDRA_ADMIN_URL=http://localhost:4445

# GitHub OAuth app (upstream identity). Create at:
#   https://github.com/settings/developers  → New OAuth App
#   Authorization callback URL = ${PUBLIC_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Cloudflare tunnel (only to test the Claude connector; see README) ---
# Create ONE tunnel with TWO public hostnames in CF Zero Trust, pointing at:
#   <fastmail host>  ->  http://service:8080
#   <auth host>      ->  http://hydra:4444
# Then set TUNNEL_TOKEN and change PUBLIC_URL + HYDRA_ISSUER above to the
# tunnel hostnames, and update the GitHub app callback to
# https://<fastmail host>/auth/github/callback. Run: docker compose --profile tunnel up
# TUNNEL_TOKEN=
