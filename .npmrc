# @radiosilence/theme is on GitHub Packages, which wants a token even for a
# public package. aube will not expand environment variables in auth settings
# a checked-in .npmrc controls, so the token lives in the gitignored file named
# here: `mise run auth` writes it from the gh login, CI from GITHUB_TOKEN.
@radiosilence:registry=https://npm.pkg.github.com
npmrc-auth-file=.npmrc.auth
