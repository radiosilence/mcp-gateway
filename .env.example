# Copy to .env for local dev (docker-compose reads it). Never commit real secrets.

# This service
BIND_ADDR=0.0.0.0:8080
PUBLIC_URL=http://localhost:8080
# 32 bytes, base64. Generate: `openssl rand -base64 32`
TOKEN_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Postgres
DATABASE_URL=postgres://fastmail:fastmail@localhost:5432/fastmail_mcp

# Hydra
# Issuer = what Claude uses to reach the AS (advertised in metadata).
HYDRA_ISSUER=http://localhost:4444
# Admin API = cluster-internal, used for introspection + login/consent.
HYDRA_ADMIN_URL=http://localhost:4445

# GitHub OAuth app (upstream identity). Create at:
#   https://github.com/settings/developers  → New OAuth App
#   Authorization callback URL = ${PUBLIC_URL}/auth/github/callback
GH_CLIENT_ID=
GH_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to authenticate. REQUIRED before any
# public deploy — empty means anyone with a GitHub account can log in and store
# credentials. e.g. GH_ALLOWED=radiosilence
GH_ALLOWED=

# Backend MCPs are declared in mcps.json (mounted at MCP_REGISTRY), not here —
# their per-user credentials are entered in the dashboard and stored encrypted.
# Nothing MCP-specific belongs in this file.

# --- Cloudflare tunnel (only to test the Claude connector) ---
# Use `mise run tunnel` — it provisions the tunnel and sets PUBLIC_URL /
# HYDRA_ISSUER to the tunnel hostnames itself, so you don't edit them here.
# You only need to set the GitHub app callback to
# https://<FASTMAIL_HOST>/auth/github/callback. See README.
