[
  {
    "id": "fastmail",
    "name": "Fastmail",
    "backend": "http://fastmail-mcp:8080/mcp",
    "credential_header": "X-Fastmail-Token",
    "key_help_url": "https://app.fastmail.com/settings/security/tokens",
    "key_hint": "fmu1-\u2026"
  },
  {
    "id": "caldav",
    "name": "Calendar (CalDAV)",
    "backend": "http://caldav-mcp:8080/mcp",
    "key_help_url": "https://appleid.apple.com",
    "fields": [
      {
        "id": "username",
        "label": "Apple ID / username",
        "header": "X-CalDAV-Username",
        "secret": false,
        "hint": "you@icloud.com"
      },
      {
        "id": "password",
        "label": "App-specific password",
        "header": "X-CalDAV-Password",
        "secret": true,
        "hint": "abcd-efgh-ijkl-mnop"
      },
      {
        "id": "url",
        "label": "CalDAV server",
        "header": "X-CalDAV-Url",
        "secret": false,
        "default": "https://caldav.icloud.com",
        "required": false
      },
      {
        "id": "calendar",
        "label": "Default calendar for new events",
        "header": "X-CalDAV-Calendar",
        "secret": false,
        "required": false,
        "hint": "Blank = whichever calendar your calendar app uses",
        "options_query": "{ options: calendars(first: 100) { nodes { value: id label: name disabled: readOnly isDefault supportsEvents } } }",
        "sync_mutation": "mutation($value: String!) { setDefaultCalendar(id: $value) { success error } }"
      }
    ],
    "graphql": "http://caldav-mcp:8080/graphql"
  },
  {
    "id": "folk",
    "name": "Folk (Mainly Norfolk)",
    "backend": "http://folk-mcp:8080/mcp",
    "public": true,
    "graphql": "http://folk-mcp:8080/graphql"
  },
  {
    "id": "tfl",
    "name": "TfL (London transport)",
    "backend": "http://tfl-mcp:8080/mcp",
    "graphql": "http://tfl-mcp:8080/graphql",
    "key_help_url": "https://api-portal.tfl.gov.uk/profile",
    "fields": [
      {
        "id": "app_key",
        "label": "TfL app key (optional \u2014 raises the rate limit)",
        "header": "X-Tfl-App-Key",
        "secret": true,
        "required": false,
        "hint": "32 hex characters"
      }
    ]
  }
]
